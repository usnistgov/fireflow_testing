from pathlib import Path
import urllib

sys.path.extend(["./workflow/scripts/python"])
from common.config import FCSConfig, ImmportSrc, FlowRepoSrc, PlainUrlSrc, ZipUrlSrc

config = FCSConfig.parse_obj(config)


plain_url_tests = [
    ("plain_url", f.src.dataset_id, n)
    for f in config.test_files
    if isinstance(f.src, PlainUrlSrc)
    for n in f.src.filemap
]

zip_url_tests = [
    ("zip_url", f.src.dataset_id, p.name)
    for f in config.test_files
    if isinstance(f.src, ZipUrlSrc)
    for p in f.src.file_paths
]

fr_tests = [
    ("flow_repository", f.src.fr_id, n)
    for f in config.test_files
    if isinstance(f.src, FlowRepoSrc)
    for n in f.src.file_names
]

im_tests = [
    ("immport", f.src.immport_id, n)
    for f in config.test_files
    if isinstance(f.src, ImmportSrc)
    for n in f.src.file_names
]

tests = [*fr_tests, *im_tests, *plain_url_tests, *zip_url_tests]

tools_dir = Path("resources/tools")
aspera_base_dir = tools_dir / "immport-data-download-tool"


rule download_aspera:
    output:
        aspera_base_dir / "aspera" / "cli" / "etc" / "aspera-license",
    params:
        url="https://downloads.immport.org/data/download/tool/immport-data-download-tool.zip",
        dst=f"{aspera_base_dir}.zip",
    shell:
        """
        curl -SsqLf -o {params.dst} {params.url} && \
        unzip -q -o {params.dst} -d $(dirname {aspera_base_dir}) && \
        rm -f {params.dst}
        """


rule download_immport:
    input:
        aspera=rules.download_aspera.output[0],
        manifest="config/immport_fcs_manifest.txt",
    output:
        "resources/immport/downloaded.txt",
    log:
        "results/log/immport",
    conda:
        "envs/immport.yml"
    script:
        "scripts/python/immport/download_immport.py"


rule download_plain_url:
    output:
        "resources/plain_url/{id}/{testname}",
    params:
        url=lambda wildcards: config.get_plain_url(wildcards.testname, wildcards.id),
    shell:
        """
        curl -SsLqf {params.url} > {output}
        """


rule download_zip_url:
    output:
        "resources/zip_url/{id}.zip",
    params:
        url=lambda wildcards: config.get_zip_url(wildcards.id),
    shell:
        """
        curl -SsLqf {params.url} > {output}
        """


rule extract_zip_url:
    input:
        rules.download_zip_url.output,
    output:
        "resources/zip_url/{id}/{testname}",
    params:
        target=lambda wildcards: config.get_zip_path(wildcards.testname, wildcards.id),
    shell:
        """
        unzip -p {input} "{params.target}" > {output}
        """


read_test_out = Path("results/read_test")
read_test_diag = read_test_out / "diag" / "{repo}" / "{id}" / "{testname}"


rule test_read:
    input:
        "resources/{repo}/{id}/{testname}",
    output:
        flag="results/read_test/pass/{repo}/{id}/{testname}.txt",
        fcs="results/read_test/fcs/{repo}/{id}/{testname}",
        # diagnostic dump
        offsets=read_test_diag / "offsets.tsv",
        nextdata_overlap=read_test_diag / "nextdata_overlap.tsv",
        offset_overlap=read_test_diag / "offset_overlap.tsv",
        key_val_pairs=read_test_diag / "key_val_pairs.tsv",
        tokens=read_test_diag / "tokens.tsv",
        fixed_scales=read_test_diag / "fixed_scales.tsv",
        original_names=read_test_diag / "original_names.tsv",
        overrange=read_test_diag / "overrange.tsv",
        version_scores=read_test_diag / "version_scores.tsv",
        misc=read_test_diag / "misc.tsv",
    log:
        "results/log/read/warnings_{repo}_{id}_{testname}.log",
    conda:
        "envs/pyreflow.yml"
    script:
        "scripts/python/fcsio/test_read.py"


rule test_double_parse:
    input:
        original="resources/{repo}/{id}/{testname}",
        std=rules.test_read.output.fcs,
    output:
        "results/double_parse/pass/{repo}/{id}/{testname}.txt",
    log:
        "results/log/double_parse/warnings_{repo}_{id}_{testname}.log",
    conda:
        "envs/pyreflow.yml"
    script:
        "scripts/python/fcsio/test_double_parse.py"


# read all important metadata from TEXT; this is done separately from reading
# the datasets initially since just reading TEXT (no DATA) is cheap and allows
# us to tweak this rule without forcing all the FCS to be reread
rule compile_metadata:
    input:
        expand(
            "resources/{repo}/{id}/{testname}",
            zip,
            repo=[x[0] for x in tests],
            id=[x[1] for x in tests],
            testname=[x[2] for x in tests],
        ),
    output:
        file_paths="results/reports/files_paths.tsv",
        machine_table="results/reports/machines.tsv",
        time_keywords="results/reports/time_keywords.tsv",
        other_root_keywords="results/reports/other_root_keywords.tsv",
        unstained_centers="results/reports/unstained_centers.tsv",
        gated_meas="results/reports/gated_meas.tsv",
        nonstd="results/reports/nonstd.tsv",
        mixed_schema="results/reports/mixed_schema.tsv",
        var_uint_schema="results/reports/var_uint_schema.tsv",
        ascii_schema="results/reports/ascii_schema.tsv",
        matrix_schema="results/reports/matrix_schema.tsv",
        ranges="results/reports/ranges.tsv",
        byteord="results/reports/byteord.tsv",
        meas_keywords="results/reports/meas_keywords.tsv",
    conda:
        "envs/pyreflow.yml"
    script:
        "scripts/python/fcsio/compile_metadata.py"


def expand_fcs(path):
    return expand(
        path,
        zip,
        repo=[x[0] for x in tests],
        id=[x[1] for x in tests],
        testname=[x[2] for x in tests],
    )


rule combine_offsets:
    input:
        expand_fcs(rules.test_read.output.offsets),
    output:
        "results/diagnostics/offsets.tsv",
    run:
        with open(output[0], "w") as fo:
            for i in input:
                with open(i, "r") as fi:
                    for x in fi:
                        fo.write(x)


use rule combine_offsets as combine_nextdata_overlap with:
    input:
        expand_fcs(rules.test_read.output.nextdata_overlap),
    output:
        "results/diagnostics/nextdata_overlap.tsv",


use rule combine_offsets as combine_offset_overlap with:
    input:
        expand_fcs(rules.test_read.output.offset_overlap),
    output:
        "results/diagnostics/offset_overlap.tsv",


use rule combine_offsets as combine_key_val_pairs with:
    input:
        expand_fcs(rules.test_read.output.key_val_pairs),
    output:
        "results/diagnostics/key_val_pairs.tsv",


use rule combine_offsets as combine_tokens with:
    input:
        expand_fcs(rules.test_read.output.tokens),
    output:
        "results/diagnostics/tokens.tsv",


use rule combine_offsets as combine_fixed_scales with:
    input:
        expand_fcs(rules.test_read.output.fixed_scales),
    output:
        "results/diagnostics/fixed_scales.tsv",


use rule combine_offsets as combine_original_names with:
    input:
        expand_fcs(rules.test_read.output.original_names),
    output:
        "results/diagnostics/original_names.tsv",


use rule combine_offsets as combine_overrange with:
    input:
        expand_fcs(rules.test_read.output.overrange),
    output:
        "results/diagnostics/overrange.tsv",


use rule combine_offsets as combine_version_scores with:
    input:
        expand_fcs(rules.test_read.output.version_scores),
    output:
        "results/diagnostics/version_scores.tsv",


use rule combine_offsets as combine_misc with:
    input:
        expand_fcs(rules.test_read.output.misc),
    output:
        "results/diagnostics/misc.tsv",


rule all:
    input:
        # rules.download_immport.output,
        rules.compile_metadata.output,
        # rules.compile_diagnostics.output,
        expand(
            rules.test_double_parse.output,
            zip,
            repo=[x[0] for x in tests],
            id=[x[1] for x in tests],
            testname=[x[2] for x in tests],
        ),
        rules.combine_offsets.output,
        rules.combine_nextdata_overlap.output,
        rules.combine_offset_overlap.output,
        rules.combine_key_val_pairs.output,
        rules.combine_tokens.output,
        rules.combine_fixed_scales.output,
        rules.combine_original_names.output,
        rules.combine_overrange.output,
        rules.combine_version_scores.output,
        rules.combine_misc.output,
