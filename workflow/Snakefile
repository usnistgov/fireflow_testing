from pathlib import Path

sys.path.extend(["./workflow/scripts/python"])
from common.config import FCSConfig, FlowRepoSrc

config = FCSConfig.parse_obj(config)

src_dir = Path("resources")
results_dir = Path("results")

tools_dir = src_dir / "tools"
aspera_base_dir = tools_dir / "immport-data-download-tool"

log_dir = results_dir / "log"

test_read_dir = results_dir / "test_read"
flowio_dir = results_dir / "flowio"
diag_dir = results_dir / "diagnostics"
metadata_dir = results_dir / "metadata"
errors_dir = results_dir / "compliance_errors"
features_dir = results_dir / "fcs_features"


rule download_aspera:
    output:
        aspera_base_dir / "aspera" / "cli" / "etc" / "aspera-license",
    params:
        url="https://downloads.immport.org/data/download/tool/immport-data-download-tool.zip",
        dst=f"{aspera_base_dir}.zip",
    shell:
        """
        curl -SsqLf -o {params.dst} {params.url} && \
        unzip -q -o {params.dst} -d $(dirname {aspera_base_dir}) && \
        rm -f {params.dst}
        """


rule download_immport:
    input:
        aspera=rules.download_aspera.output[0],
    output:
        src_dir / "immport" / "downloaded.txt",
    log:
        log_dir / "immport",
    script:
        "scripts/python/immport/download_immport.py"


rule download_misc_repos:
    output:
        src_dir / "misc_repo" / "{id}" / ".downloaded.txt",
    script:
        "scripts/python/fcsio/download_archive.py"


# these can't be downloaded automatically, so the user will need to extract them
# into the paths listed here manually
rule list_flow_repo_files:
    output:
        src_dir / "flow_repository" / "downloaded.txt",
    params:
        targets=lambda wildcards, output: [
            str(Path(output[0]).parent / f.src.fr_id / n)
            for f in config.test_files
            if isinstance(f.src, FlowRepoSrc)
            for n in f.src.file_names
        ],
    run:
        from pathlib import Path

        with open(output[0], "w") as f:
            for t in params.targets:
                f.write(t + "\n")


rule list_all_fcs_files:
    input:
        misc=expand(rules.download_misc_repos.output, id=config.get_misc_dataset_ids()),
        immport=rules.download_immport.output,
        fr=rules.list_flow_repo_files.output,
    output:
        src_dir / "all_fcs_files.txt",
    shell:
        """
        cat {input.misc} \
            {input.immport} \
            {input.fr} \
        > {output}
        """


rule clone_flowio:
    output:
        directory(tools_dir / "flowio")
    params:
        url="https://bitbucket.org/Mira_Koblizek/flowio/commits/47ef24487ead37efbe3d06674a37b769c6be49ab"
        # target = lambda wildcards, output: Path(output[0]).parent
    shell:
        """
        git clone {params.url} {output}
        """


rule run_flowio:
    input:
        files=rules.list_all_fcs_files.output,
        flowio=rules.clone_flowio.output,
    output:
        results=flowio_dir / "results.tsv",
        errors=flowio_dir / "errors.tsv",
    conda:
        "envs/flowio.yml"
    threads: 20
    script:
        "scripts/R/run_flowio.R"


rule test_read:
    input:
        rules.list_all_fcs_files.output,
    output:
        fcs=test_read_dir / "fcs" / "tested.txt",
        # diagnostic dump
        offsets=diag_dir / "offsets.tsv",
        overflow=diag_dir / "overflow.tsv",
        overlap=diag_dir / "overlap.tsv",
        key_val_pairs=diag_dir / "key_val_pairs.tsv",
        tokens=diag_dir / "tokens.tsv",
        fixed_scales=diag_dir / "fixed_scales.tsv",
        original_names=diag_dir / "original_names.tsv",
        overrange=diag_dir / "overrange.tsv",
        version_scores=diag_dir / "version_scores.tsv",
        padding=diag_dir / "padding.tsv",
        dark_bytes=diag_dir / "dark_bytes.tsv",
        misc=diag_dir / "misc.tsv",
    log:
        log_dir / "test_read.log",
    threads: 20
    script:
        "scripts/python/fcsio/test_read.py"


rule test_double_parse:
    input:
        original=rules.list_all_fcs_files.output[0],
        std=rules.test_read.output.fcs,
    output:
        results_dir / "double_parse" / "pass.txt",
    log:
        log_dir / "double_parse.log",
    threads: 20
    script:
        "scripts/python/fcsio/test_double_parse.py"


# read all important metadata from TEXT; this is done separately from reading
# the datasets initially since just reading TEXT (no DATA) is cheap and allows
# us to tweak this rule without forcing all the FCS to be reread
rule compile_metadata:
    input:
        rules.list_all_fcs_files.output[0],
    output:
        file_paths=metadata_dir / "files_paths.tsv",
        machine_table=metadata_dir / "machines.tsv",
        time_keywords=metadata_dir / "time_keywords.tsv",
        other_root_keywords=metadata_dir / "other_root_keywords.tsv",
        unstained_centers=metadata_dir / "unstained_centers.tsv",
        gated_meas=metadata_dir / "gated_meas.tsv",
        nonstd=metadata_dir / "nonstd.tsv",
        mixed_schema=metadata_dir / "mixed_schema.tsv",
        var_uint_schema=metadata_dir / "var_uint_schema.tsv",
        ascii_schema=metadata_dir / "ascii_schema.tsv",
        matrix_schema=metadata_dir / "matrix_schema.tsv",
        ranges=metadata_dir / "ranges.tsv",
        byteord=metadata_dir / "byteord.tsv",
        meas_keywords=metadata_dir / "meas_keywords.tsv",
    threads: 20
    script:
        "scripts/python/fcsio/compile_metadata.py"


rule compile_errors:
    input:
        **rules.test_read.output,
        machines=rules.compile_metadata.output.machine_table,
    output:
        table=errors_dir / "errors.tsv",
        plot_errors=errors_dir / "errors.svg",
        plot_version_change=errors_dir / "version_change.svg",
    conda:
        "envs/tidyverse.yml"
    script:
        "scripts/R/compile_errors.R"


rule compile_features:
    input:
        **rules.compile_metadata.output,
        **rules.test_read.output,
    output:
        # tables
        kw_usage=features_dir / "kw_usage.tsv",
        schema=features_dir / "schema.tsv",
        # plots
        plot_datasets=features_dir / "datasets.svg",
        plot_supp_text=features_dir / "supp_text.svg",
        plot_analysis=features_dir / "analysis.svg",
        plot_other_seg=features_dir / "other_seg.svg",
        plot_crc=features_dir / "crc.svg",
        plot_dark=features_dir / "dark.svg",
        plot_scaling=features_dir / "scaling.svg",
        plot_byteord=features_dir / "byteord.svg",
        plot_schema=features_dir / "schema.svg",
        plot_kw_usage=features_dir / "kw_usage.svg",
    conda:
        "envs/tidyverse.yml"
    script:
        "scripts/R/compile_features.R"


rule dump_cyt_mapping:
    output:
        "results/features/cyt_mapping.tsv",
    script:
        "scripts/python/fcsio/dump_cyt_mapping.py"


rule create_summary:
    input:
        **rules.compile_features.output,
        plot_errors=rules.compile_errors.output.plot_errors,
        plot_version_change=rules.compile_errors.output.plot_version_change,
        machines=rules.compile_metadata.output.machine_table,
        cyt_mapping=rules.dump_cyt_mapping.output,
    output:
        results_dir / "summaries" / "summary.html",
    conda:
        "envs/tidyverse.yml"
    script:
        "scripts/Rmd/create_summary.Rmd"


rule all:
    input:
        rules.test_read.output,
        rules.test_double_parse.output,
        rules.compile_metadata.output,
        rules.compile_errors.output,
        rules.compile_features.output,
        rules.create_summary.output,
        rules.run_flowio.output,
